# ── Ravikishan independent section backend — environment template ─────────
# Copy this file to .env and fill in real values. Never commit .env.
#
# This service is the template for every FUTURE section (see the recipe in
# ARCHITECTURE.md §6). It is a fully independent deployment: its own Render
# service and its own Neon project. It shares NOTHING with the global backend
# except two secrets (see below).
# ─────────────────────────────────────────────────────────────────────────

# Its OWN PostgreSQL connection string — a BRAND-NEW Neon project. Never
# reuse the global/Class 11 DATABASE_URL / NEON_CLASS11_URL.
# Local dev: the repo's docker-compose.dev.yml runs Postgres on port 5433.
DATABASE_URL="postgresql://raviki:raviki_dev_pw@localhost:5433/ravikishan_class12_test?schema=public"

# ── Shared with the GLOBAL backend (the only two shared values) ────────────
# JWT_ACCESS_SECRET: MUST be the IDENTICAL value the global auth service
# signs access tokens with. This service only VERIFIES tokens (payload-only,
# no DB, no network) — it never signs, issues or refreshes them. A token
# issued by the global backend works here unchanged; expired or forged
# tokens are rejected locally.
JWT_ACCESS_SECRET="replace-with-same-value-as-global-backend"

# PROGRESS_SYNC_SECRET: service-to-service secret for the internal
# progress-sync API. MUST equal the global backend's PROGRESS_SYNC_SECRET.
# Do NOT reuse JWT_ACCESS_SECRET for this.
PROGRESS_SYNC_SECRET="replace-with-long-random-sync-secret"

# PROGRESS_SYNC_URL: base URL of the GLOBAL backend (the only place progress/
# XP/streaks live). Local dev: http://localhost:4000. Production: the global
# service's public URL, e.g. https://ravikishan-api.onrender.com
PROGRESS_SYNC_URL="http://localhost:4000"

# ── Section identity (which section this service serves) ──────────────────
# A section backend serves exactly ONE section. Change these when copying
# this directory for a real section.
SECTION_ID="class-12-test"
SECTION_LABEL="Class 12 (test)"
SECTION_CLASS_SLUG="class-12-test"
SECTION_CONTENT_DIR="content/class-12-test"

# ── Its own local AI instance (scoped to this section's content only) ─────
# Leave AI_ENDPOINT + AI_API_KEY empty for offline-first mode (answers are
# grounded in the section's own notes without any external API).
AI_ENDPOINT=""
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# ── Its own object storage (separate R2 bucket) ───────────────────────────
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Frontend origin(s) allowed by CORS — the SAME origins as the global
# backend's CORS_ORIGIN (the frontend calls both backends from one browser
# origin). Comma-separate multiple if needed.
CORS_ALLOWED_ORIGIN="http://localhost:5173"

# Server
PORT=4100
NODE_ENV="development"

# Progress-sync outbox tuning (optional)
SYNC_BATCH_SIZE="50"
SYNC_INTERVAL_MS="30000"
SYNC_MAX_ATTEMPTS="10"
