// ─────────────────────────────────────────────────────────────────────────
// Section backend schema — single Prisma schema for one independent section.
//
// This file is the content schema of ONE section (see ARCHITECTURE.md). It
// contains ONLY section-scoped tables: the content tables (same models as
// the global backend's schema.class11.prisma) plus the section-local
// progress/outbox tables (ChapterProgress, BlockCompletion, ProgressEvent).
//
// Deliberately ABSENT (they live in the global backend's Neon):
//   User, PasswordHash, RefreshToken, UserProgress, Bookmark, StudyStreak,
//   XpEntry, Badge, Notification, Quiz*, Flashcard*, planner tables, admin/
//   audit tables. This service cannot create/modify users — it only
//   VERIFIES tokens issued by the global auth service (shared secret).
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubjectType {
  science_math
  biology
  english
  nepali
  general_knowledge
}

enum Difficulty {
  easy
  medium
  hard
  expert
}

enum ContentStatus {
  draft
  published
  archived
}

enum BlockType {
  note_topic
  note_statement
  note_example
  note_concept
  note_important
  numerical
  mindmap
  diagram_compare
  summary
  keywords
  important_points
  byakaran
  formula
  symbols
  learning_outcome
  mind_recall
  pyq
  solved_example
  premium_expansion
  reference
  revision_summary
}

model Class {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  subjects  Subject[]
}

model Subject {
  id             String            @id @default(uuid())
  classId        String
  class          Class             @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name           String
  slug           String
  subjectType    SubjectType
  icon           String?
  themeColor     String?
  isLocked       Boolean           @default(true)
  sortOrder      Int               @default(0)
  status         ContentStatus     @default(draft)
  description    String?
  difficulty     Difficulty        @default(easy)
  chapters       Chapter[]
  customSubjects CustomSubject[]

  @@unique([classId, slug])
  @@index([subjectType])
  @@index([status])
}

model CustomSubject {
  id        String   @id @default(uuid())
  name      String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

model Chapter {
  id            String            @id @default(uuid())
  subjectId     String
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title         String
  slug          String
  isLocked      Boolean           @default(true)
  sortOrder     Int               @default(0)
  status        ContentStatus     @default(draft)
  prerequisites String?
  readingTime   Int?
  metadata      Json?             @default("{}")
  blocks        ContentBlock[]
  topics        Topic[]
  progress      ChapterProgress[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model ContentBlock {
  id              String         @id @default(uuid())
  chapterId       String
  chapter         Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  topicId         String?
  topic           Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  blockType       BlockType
  status          ContentStatus  @default(draft)
  accessLevel     Int            @default(3)
  difficulty      Difficulty     @default(easy)
  title           String?
  contentRichtext String?
  contentCode     String?
  codeLanguage    String?
  mindmapJson     Json?
  diagramData     Json?
  subLevel        String?
  classifiedBy    String?
  sectionIndex    Int?
  metadata        Json?
  isDuplicateOf   String?
  searchVectorEnglish Unsupported("tsvector")? @map("search_vector_english")
  searchVectorSimple  Unsupported("tsvector")? @map("search_vector_simple")
  sortOrder       Int            @default(0)
  versions        ContentVersion[]
  blockTags       BlockTag[]
  completions     BlockCompletion[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([chapterId, sortOrder])
  @@index([sortOrder])
  @@index([accessLevel])
  @@index([blockType])
  @@index([difficulty])
  @@index([topicId])
  @@index([sectionIndex])
  @@index([searchVectorEnglish(type: Gin)], map: "idx_content_search_english")
  @@index([searchVectorSimple(type: Gin)], map: "idx_content_search_simple")
}

// ── CMS ──────────────────────────────────────────────────────────

model Topic {
  id          String   @id @default(uuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title       String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  status      ContentStatus @default(draft)
  metadata    Json?
  validationReport Json?
  blocks      ContentBlock[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model ContentVersion {
  id          String   @id @default(uuid())
  blockId     String
  block       ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  version     Int
  title       String?
  contentRichtext String?
  contentCode     String?
  codeLanguage    String?
  mindmapJson     Json?
  diagramData     Json?
  subLevel        String?
  changedBy   String?
  createdAt   DateTime @default(now())

  @@unique([blockId, version])
  @@index([blockId])
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())

  blockTags   BlockTag[]
}

model BlockTag {
  id        String   @id @default(uuid())
  blockId   String
  tagId     String
  block     ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tag       Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([blockId, tagId])
  @@index([blockId])
  @@index([tagId])
}

// ── Section-local progress ────────────────────────────────────────────────
// Where a user is in THIS section's chapters lives here (FKs into this
// section's own Chapter/ContentBlock rows — it cannot live in the global
// DB, whose Chapter table holds other sections' content). Aggregates that
// matter globally (XP, daily minutes, streaks, analytics) are pushed to the
// global backend through the internal progress-sync API; see
// src/services/progressSync.js. The section service never decides
// gamification — it only reports.

model ChapterProgress {
  id             String   @id @default(uuid())
  userId         String
  chapterId      String
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blocksCompleted Int     @default(0)
  totalBlocks    Int      @default(0)
  lastBlockId    String?
  lastAccessedAt DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

model BlockCompletion {
  id          String       @id @default(uuid())
  userId      String
  blockId     String
  block       ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  chapterId   String
  completedAt DateTime     @default(now())

  @@unique([userId, blockId])
  @@index([userId])
  @@index([chapterId])
}

// Outbox for the internal progress-sync API: events are written here
// FIRST, then pushed to the global backend with retry + exponential
// backoff. A global outage never loses progress — the queue drains when
// the global service is reachable again.
model ProgressEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // xp | minutes | streak | learning
  payload   Json
  attempts  Int      @default(0)
  lastError String?
  syncedAt  DateTime?
  createdAt DateTime @default(now())

  @@index([syncedAt])
  @@index([createdAt])
}
