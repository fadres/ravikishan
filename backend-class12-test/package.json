{
  "name": "ravikishan-class12-test-backend",
  "version": "1.0.0",
  "description": "Ravikishan independent section backend — template for future sections (own Render service + own Neon). Serves content/search/AI for ONE section; trusts the global auth service via shared JWT.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
    "generate": "prisma generate",
    "seed:demo": "node prisma/seed-demo.js",
    "import-notes": "node prisma/import-notes.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "supertest": "^7.1.0"
  }
}
