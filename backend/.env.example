# ── Ravikishan backend environment template ──────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Free tiers: Neon (neon.tech) or Supabase (supabase.com) — permanent free Postgres.
# Local dev: the repo's docker-compose.dev.yml runs Postgres on port 5433.
DATABASE_URL="postgresql://raviki:raviki_dev_pw@localhost:5433/ravikishan?schema=public"

# ── Multi-section boundary (see ARCHITECTURE.md) ──────────────────────────
# The existing DATABASE_URL above is officially the CLASS 11 database.
# NEON_CLASS11_URL is its canonical alias — the app falls back to
# DATABASE_URL when it is unset, so nothing needs to change today. Set it
# to the same value to make the labeling explicit:
# NEON_CLASS11_URL="postgresql://...same-as-DATABASE_URL..."
#
# Every FUTURE section (Class 12, other tracks) gets a BRAND-NEW Neon
# project/account and its own env var (e.g. CLASS12_DB_URL). NEVER point a
# new section at NEON_CLASS11_URL. Optional per-section AI overrides:
# CLASS11_AI_ENDPOINT="..." (defaults to the shared AI_ENDPOINT below).

# ── Independent-service section (class-12-test) ────────────────────────────
# Unlike class-11, this section does NOT run inside this backend — it is its
# own service (backend-class12-test/) with its own Neon, own AI endpoint and
# own progress outbox. The global backend NEVER connects to its database.
# CLASS12_BACKEND_URL is its public base URL; when set, the global backend
# proxies class-12-test content/search/AI requests to it:
# CLASS12_BACKEND_URL="http://localhost:4100"
# NEON_CLASS12_URL="postgresql://...its-own-neon..."
# CLASS12_AI_ENDPOINT=""           # optional — defaults to the shared AI_ENDPOINT
#
# Service-to-service secret for POST /internal/progress-sync. MUST be the
# same value as the section service's PROGRESS_SYNC_SECRET (and different
# from the JWT secrets). Leave empty to reject all internal sync calls:
# PROGRESS_SYNC_SECRET="replace-with-long-random-string-3"

# JWT signing secrets — generate long random values, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET="replace-with-long-random-string-1"
JWT_REFRESH_SECRET="replace-with-long-random-string-2"

# Token lifetimes
ACCESS_TOKEN_TTL="15m"           # short-lived access token
REFRESH_TOKEN_TTL_DAYS="30"      # refresh token validity in days

# Owner bootstrap account (used by the seed script)
OWNER_EMAIL="harindarsah98172@gmail.com"
OWNER_PASSWORD="change-me-strong-password"

# Frontend origin allowed by CORS (comma-separate multiple if needed)
CORS_ORIGIN="http://localhost:5173"

# GMail notifications to members on content add/update.
# SMTP_PASS must be a Gmail App Password (https://myaccount.google.com/apppasswords),
# NOT the normal account password. Leave SMTP_PASS empty to disable mail.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-account@gmail.com"
SMTP_PASS=""
MAIL_FROM=""                       # optional — defaults to SMTP_USER
SITE_URL="https://ravikisan.netlify.app"

# Cloudflare R2 (S3-compatible object storage)
# Get these from your Cloudflare R2 dashboard → Settings → API Tokens
# R2_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Server
PORT=4000
NODE_ENV="development"

# Performance instrumentation: set to 1 to enable per-request timing and
# query stats via X-Perf-* response headers (used for load testing).
