generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
  guest
}

enum RequestStatus {
  pending
  approved
  denied
}

enum SubjectType {
  science_math
  biology
  english
  nepali
  general_knowledge
}

enum BlockType {
  note_topic
  note_statement
  note_example
  note_concept
  note_important
  numerical
  mindmap
  diagram_compare
  summary
  keywords
  important_points
  byakaran
  formula
  symbols
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  displayName      String?
  role             Role          @default(guest)
  isApproved       Boolean       @default(false)
  accessLevel      Int           @default(3)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  passwordHashes   PasswordHash[]
  refreshTokens    RefreshToken[]
  accessRequests   AccessRequest[]
  resolvedRequests AccessRequest[] @relation("ResolvedBy")
  auditLogs        AuditLog[]
  decisionMakers   DecisionMaker[]

  @@index([role])
  @@index([accessLevel])
}

model PasswordHash {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hash      String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AccessRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  email        String
  message      String?
  status       RequestStatus @default(pending)
  requestedAt  DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?         @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([userId, status])
}

model Class {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  subjects  Subject[]

  @@index([slug])
}

model Subject {
  id             String            @id @default(uuid())
  classId        String
  class          Class             @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name           String
  slug           String
  subjectType    SubjectType
  icon           String?
  themeColor     String?
  isLocked       Boolean           @default(true)
  sortOrder      Int               @default(0)
  chapters       Chapter[]
  customSubjects CustomSubject[]

  @@unique([classId, slug])
  @@index([subjectType])
}

model CustomSubject {
  id        String   @id @default(uuid())
  name      String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

model Chapter {
  id        String         @id @default(uuid())
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title     String
  slug      String
  isLocked  Boolean        @default(true)
  sortOrder Int            @default(0)
  blocks    ContentBlock[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model ContentBlock {
  id              String         @id @default(uuid())
  chapterId       String
  chapter         Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blockType       BlockType
  accessLevel     Int            @default(3)
  title           String?
  contentRichtext String?
  contentCode     String?
  codeLanguage    String?
  mindmapJson     Json?
  diagramData     Json?
  subLevel        String?
  sortOrder       Int            @default(0)
  decisionMaker   DecisionMaker?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([chapterId, sortOrder])
  @@index([accessLevel])
  @@index([blockType])
}

model DecisionMaker {
  id             String       @id @default(uuid())
  contentBlockId String       @unique
  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decidedAt      DateTime     @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorId    String?
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}