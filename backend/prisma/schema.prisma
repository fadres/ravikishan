generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
  guest
}

enum RequestStatus {
  pending
  approved
  denied
}

enum SubjectType {
  science_math
  biology
  english
  nepali
  general_knowledge
}

enum Difficulty {
  easy
  medium
  hard
  expert
}

enum ContentStatus {
  draft
  published
  archived
}

enum BlockType {
  note_topic
  note_statement
  note_example
  note_concept
  note_important
  numerical
  mindmap
  diagram_compare
  summary
  keywords
  important_points
  byakaran
  formula
  symbols
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  displayName      String?
  role             Role          @default(guest)
  isApproved       Boolean       @default(false)
  accessLevel      Int           @default(3)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  passwordHashes   PasswordHash[]
  refreshTokens    RefreshToken[]
  accessRequests   AccessRequest[]
  resolvedRequests AccessRequest[] @relation("ResolvedBy")
  auditLogs        AuditLog[]
  decisionMakers   DecisionMaker[]
  r2Uploads        R2Upload[]
  contentVersions  ContentVersion[]
  userProgress     UserProgress[]
  bookmarks        Bookmark[]
  studyStreak      StudyStreak?
  learningAnalytics LearningAnalytics[]

  @@index([role])
  @@index([accessLevel])
}

model PasswordHash {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hash      String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AccessRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  email        String
  message      String?
  status       RequestStatus @default(pending)
  requestedAt  DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?         @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([userId, status])
}

model Class {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  subjects  Subject[]

  @@index([slug])
}

model Subject {
  id             String            @id @default(uuid())
  classId        String
  class          Class             @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name           String
  slug           String
  subjectType    SubjectType
  icon           String?
  themeColor     String?
  isLocked       Boolean           @default(true)
  sortOrder      Int               @default(0)
  status         ContentStatus     @default(draft)
  description    String?
  difficulty     Difficulty        @default(easy)
  chapters       Chapter[]
  customSubjects CustomSubject[]

  @@unique([classId, slug])
  @@index([subjectType])
  @@index([status])
}

model CustomSubject {
  id        String   @id @default(uuid())
  name      String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

model Chapter {
  id             String            @id @default(uuid())
  subjectId      String
  subject        Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title          String
  slug           String
  isLocked       Boolean           @default(true)
  sortOrder      Int               @default(0)
  status         ContentStatus     @default(draft)
  prerequisites  String?
  readingTime    Int?
  blocks         ContentBlock[]
  topics         Topic[]
  userProgress   UserProgress[]
  bookmarks      Bookmark[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model ContentBlock {
  id              String         @id @default(uuid())
  chapterId       String
  chapter         Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blockType       BlockType
  accessLevel     Int            @default(3)
  difficulty      Difficulty     @default(easy)
  title           String?
  contentRichtext String?
  contentCode     String?
  codeLanguage    String?
  mindmapJson     Json?
  diagramData     Json?
  subLevel        String?
  sortOrder       Int            @default(0)
  decisionMaker   DecisionMaker?
  versions        ContentVersion[]
  blockTags       BlockTag[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([chapterId, sortOrder])
  @@index([sortOrder])
  @@index([accessLevel])
  @@index([blockType])
  @@index([difficulty])
}

model DecisionMaker {
  id             String       @id @default(uuid())
  contentBlockId String       @unique
  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decidedAt      DateTime     @default(now())

  @@index([userId])
}

enum UploadStatus {
  pending
  complete
  failed
  deleted
}

model R2Upload {
  id               String        @id @default(uuid())
  key              String        @unique
  originalFilename String
  fileUrl          String?
  bucket           String?
  fileSize         Int?
  mimeType         String
  fileHash         String?
  status           UploadStatus  @default(pending)
  uploadedBy       User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedById     String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([uploadedById])
  @@index([createdAt])
  @@index([status])
  @@index([fileHash])
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorId    String?
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt, targetId])
  @@index([actorId])
  @@index([action])
}

// ── CMS ──────────────────────────────────────────────────────────

model Topic {
  id          String   @id @default(uuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title       String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  status      ContentStatus @default(draft)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model ContentVersion {
  id          String   @id @default(uuid())
  blockId     String
  block       ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  version     Int
  title       String?
  contentRichtext String?
  contentCode     String?
  codeLanguage    String?
  mindmapJson     Json?
  diagramData     Json?
  subLevel        String?
  changedBy   String
  user        User     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById String
  createdAt   DateTime @default(now())

  @@unique([blockId, version])
  @@index([blockId])
  @@index([changedById])
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())

  blockTags   BlockTag[]
}

model BlockTag {
  id        String   @id @default(uuid())
  blockId   String
  tagId     String
  block     ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tag       Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([blockId, tagId])
  @@index([blockId])
  @@index([tagId])
}

// ── Progress Tracking ────────────────────────────────────────────

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blocksCompleted Int  @default(0)
  totalBlocks    Int   @default(0)
  lastBlockId   String?
  lastAccessedAt DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blockId   String?
  label     String?
  createdAt DateTime @default(now())

  @@unique([userId, chapterId, blockId])
  @@index([userId])
  @@index([chapterId])
}

model StudyStreak {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  streak      Int      @default(1)
  lastDate    DateTime @default(now())
  longestStreak Int   @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId])
}

model LearningAnalytics {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String
  chapterId   String?
  blockId     String?
  timeSpent   Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}