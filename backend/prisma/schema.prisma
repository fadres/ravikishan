// ─────────────────────────────────────────────────────────────────────────
// Prisma schema root for the multi-section architecture.
// See ARCHITECTURE.md at the repo root.
//
// Prisma treats every *.prisma file in this folder as ONE schema:
//   • schema.prisma          — generator + datasource + shared enums
//   • schema.global.prisma   — GLOBAL tables (accounts, progress,
//                              gamification, notifications, admin, audit)
//   • schema.class11.prisma  — CLASS 11 section content tables
//
// Today both global and Class 11 content tables live in the same
// connection (env "DATABASE_URL", aliased NEON_CLASS11_URL). A future
// section adds its own schema.<section>.prisma pointing at its OWN
// brand-new Neon project — never this one.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
  guest
}

enum QuestionType {
  mcq
  true_false
  fill_blank
  short_answer
}

enum AttemptStatus {
  in_progress
  completed
  abandoned
}

enum GoalPeriod {
  daily
  weekly
  monthly
}

enum RequestStatus {
  pending
  approved
  denied
}

enum SubjectType {
  science_math
  biology
  english
  nepali
  general_knowledge
}

enum Difficulty {
  easy
  medium
  hard
  expert
}

enum ContentStatus {
  draft
  published
  archived
}

enum BlockType {
  note_topic
  note_statement
  note_example
  note_concept
  note_important
  numerical
  mindmap
  diagram_compare
  summary
  keywords
  important_points
  byakaran
  formula
  symbols
  learning_outcome
  mind_recall
  pyq
  solved_example
  premium_expansion
  reference
  revision_summary
}

enum UploadStatus {
  pending
  complete
  failed
  deleted
}
