{
  "name": "ravikishan-backend",
  "version": "1.0.0",
  "description": "Ravikishan exam-prep platform — backend API (Express + Prisma + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "prisma db push --accept-data-loss && node prisma/ensure-owner.js && node prisma/import-content.js",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "ensure-owner": "node prisma/ensure-owner.js",
    "content:import": "node prisma/import-content.js",
    "import-notes": "node prisma/import-notes.js",
    "clone:11e": "node prisma/clone-class.js",
    "promote-11e": "node prisma/promote-class-11e.js",
    "import-11e": "node prisma/import-notes.js --section class-11e",
    "content:restructure": "node prisma/restructure-syllabus.mjs",
    "content:prune": "node prisma/prune-orphans.mjs",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "htmlparser2": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "prisma": "^6.5.0",
    "supertest": "^7.1.0"
  }
}
